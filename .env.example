# Copy to .env and fill in. Never commit the real .env.

# Required. SEC EDGAR needs contact info in the User-Agent; the client sends "FinSentinel <EMAIL>".
EMAIL=you@example.com
# Optional full override of the User-Agent string:
# SEC_USER_AGENT="Your Name you@example.com"

# Optional. If set, the final memo is written via OpenRouter; otherwise the local model writes it.
OPENROUTER_KEY=

# Optional. Langfuse tracing; leave blank to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional local LLM overrides (any OpenAI-compatible server).
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=your-served-model-name
